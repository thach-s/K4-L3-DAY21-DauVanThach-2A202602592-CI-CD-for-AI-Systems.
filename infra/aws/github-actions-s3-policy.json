{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListDvcObjects",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::income-mlops-lab-880882846227-us-east-1",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "dvc",
            "dvc/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadDvcObjects",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::income-mlops-lab-880882846227-us-east-1/dvc/*"
    },
    {
      "Sid": "PublishCurrentModel",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::income-mlops-lab-880882846227-us-east-1/artifacts/current/model.joblib"
    }
  ]
}
